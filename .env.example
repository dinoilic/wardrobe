# Provider: "openai" (default) or "azure"
WARDROBE_AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Azure OpenAI / Microsoft Foundry. Values are deployment names, not model names.
# Only read when WARDROBE_AI_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
# AZURE_OPENAI_GARMENT_DEPLOYMENT=
# AZURE_OPENAI_MODELED_DEPLOYMENT=
# AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Concurrent model requests. Defaults to 1 on Azure, 2 on OpenAI.
# WARDROBE_AI_CONCURRENCY=

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
